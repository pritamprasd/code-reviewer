+import React, { useState, useEffect } from 'react';
+
+interface UserProfileProps {
+  userId: string;
+  onUpdate?: () => void;
+}
+
+export const UserProfile: React.FC<UserProfileProps> = ({ userId, onUpdate }) => {
+  const [userData, setUserData] = useState<any>(null);
+  const [logs, setLogs] = useState<string[]>([]);
+
+  useEffect(() => {
+    // Fetch user details
+    fetch(`/api/users/${userId}`)
+      .then(res => res.json())
+      .then(data => {
+        setUserData(data);
+        logs.push(`Loaded user: ${data.name}`); // Direct state mutation
+        setLogs(logs);
+      });
+    // Missing userId and logs in dependency array
+  }, []);
+
+  return (
+    <div className="profile-container">
+      <h2>{userData?.name || 'Loading...'}</h2>
+      <div onClick={() => onUpdate && onUpdate()} className="clickable-badge">
+        Click to refresh
+      </div>
+      <ul>
+        {logs.map((log, index) => (
+          <li key={index}>{log}</li>
+        ))}
+      </ul>
+    </div>
+  );
+};
